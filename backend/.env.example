# HTTP server port. Defaults to 3001 when unset.
PORT=3001

# Set to development, test, or production.
NODE_ENV=development

# Fictional local development database URI. Production must provide its own URI.
MONGODB_URI=mongodb://127.0.0.1:27017/budgetflow

# Invalid placeholder: set a private random secret of at least 32 bytes in production.
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment

# Comma-separated HTTP(S) origins (scheme + host + optional port; no paths).
# Production must list every frontend origin explicitly.
FRONTEND_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
