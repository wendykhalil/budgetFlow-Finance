# HTTP server port.
PORT=3001

# Use development locally; production hides internal errors.
NODE_ENV=development

# Local development database. Replace with the URI for your own MongoDB database.
MONGODB_URI=mongodb://127.0.0.1:27017/budgetflow

# Replace this placeholder with a long, random secret before deployment.
JWT_SECRET=replace-this-with-a-long-random-secret-before-deployment

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
