# Port used by the backend HTTP server.
PORT=3001

# Use development locally; production hides internal error details.
NODE_ENV=development

# Required to enable database-backed readiness. Replace with your own URI.
MONGODB_URI=mongodb://127.0.0.1:27017/budgetflow

# Comma-separated browser origins allowed to call the API.
# Add the frontend's origin here (for example, http://localhost:8443).
FRONTEND_ORIGINS=http://localhost:8443,http://127.0.0.1:8443
